{
  "name": "jess-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "jess-web SPA. React + TypeScript + xterm.js, bundled via Vite and embedded into the Go binary via go:embed (Teleport pattern).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node -e \"require('fs').writeFileSync('dist/.gitkeep','')\"",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "tsc -b --noEmit"
  },
  "dependencies": {
    "@carbon/icons-react": "11.91.0",
    "@carbon/react": "1.119.0",
    "@carbon/styles": "1.118.0",
    "@ibm/plex": "6.4.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "asciinema-player": "3.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-is": "19.3.1",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-is": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "sass": "1.107.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "packageManager": "pnpm@9.15.9"
}
